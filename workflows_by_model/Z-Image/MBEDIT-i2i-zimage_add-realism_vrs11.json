      "widgets_values": [
        "# ONE SAMPLER RUN TO FIX UP IMAGES:\n\ndisable the resize by long edge\ndisable the second KSampler\ndisable the upscale by latent\nset your remaining KSampler to 0.1 (from 0.5 my default for 2 samplers)\n\nDENOISE:\n\n- light fix without losing consistency: 0.1 or less (try 0.05)\n\n- 0.2 to deplastic a face without losing consistency. (e.g. Klein swap inpaint outputs)\n\n- good improvements but it will change faces, 0.3 or more\n\n\n"
      ],
      "widgets_values_named": {
        "text": "# ONE SAMPLER RUN TO FIX UP IMAGES:\n\ndisable the resize by long edge\ndisable the second KSampler\ndisable the upscale by latent\nset your remaining KSampler to 0.1 (from 0.5 my default for 2 samplers)\n\nDENOISE:\n\n- light fix without losing consistency: 0.1 or less (try 0.05)\n\n- 0.2 to deplastic a face without losing consistency. (e.g. Klein swap inpaint outputs)\n\n- good improvements but it will change faces, 0.3 or more\n\n\n"
      },
      "color": "#432",
